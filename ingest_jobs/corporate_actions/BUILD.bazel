# Thin job binary. Lifecycle only; di wires the ingest agent, tools dispatch commands.
load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_binary(
    name = "corporate_actions",
    embed = [":corporate_actions_lib"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "corporate_actions_lib",
    srcs = ["main.go"],
    importpath = "github.com/tcw165/fintech-fun/ingest_jobs/corporate_actions",
    visibility = ["//visibility:private"],
    deps = [
        "//ingest_jobs/corporate_actions/cli",
        "//ingest_jobs/corporate_actions/request",
        "//ingest_jobs/corporate_actions/tools",
        "//ingest_jobs/di",
    ],
)
