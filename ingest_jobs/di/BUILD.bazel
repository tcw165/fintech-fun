# Ingest job composition root. Wires skill + graph clients.
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "di",
    srcs = [
        "context.go",
        "wire.go",
    ],
    importpath = "github.com/tcw165/fintech-fun/ingest_jobs/di",
    visibility = ["//visibility:public"],
    deps = [
        "//agents/skills/ingest/robinhood/corporate_actions/skill",
        "//graph/clients/neo4j:neo4j",
        "//graph/clients/neo4j/impl:impl",
        "//graph/clients/qdrant:qdrant",
        "//graph/clients/qdrant/impl:impl",
        "//graph/embed:embed",
        "//graph/embed/lexical:lexical",
    ],
)

go_test(
    name = "di_test",
    srcs = ["context_test.go"],
    embed = [":di"],
    deps = [
        "//graph/clients/neo4j/impl:impl",
        "//graph/clients/qdrant/impl:impl",
        "//graph/embed/lexical:lexical",
    ],
)
