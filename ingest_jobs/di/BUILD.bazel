# Ingest job composition root. Wires ingest agent + graph clients.
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "di",
    srcs = [
        "context.go",
        "module.go",
        "wire.go",
    ],
    importpath = "github.com/tcw165/fintech-fun/ingest_jobs/di",
    visibility = ["//visibility:public"],
    deps = [
        "//agents/skills/ingest/robinhood/corporate_actions/agent",
        "//graph/clients/neo4j",
        "//graph/clients/neo4j/impl",
        "//graph/clients/qdrant",
        "//graph/clients/qdrant/impl",
        "//graph/embed",
        "//graph/embed/lexical",
        "@org_uber_go_fx//:fx",
    ],
)

go_test(
    name = "di_test",
    srcs = [
        "context_test.go",
        "fx_test.go",
    ],
    embed = [":di"],
    deps = [
        "//graph/clients/neo4j/impl",
        "//graph/clients/qdrant/impl",
        "//graph/embed/lexical",
        "@org_uber_go_fx//:fx",
    ],
)
