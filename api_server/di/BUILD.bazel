# API process composition root. Wires impl + graph clients.
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "di",
    srcs = [
        "context.go",
        "wire.go",
    ],
    importpath = "github.com/tcw165/fintech-fun/api_server/di",
    visibility = ["//visibility:public"],
    deps = [
        "//api_server/contract",
        "//api_server/impl",
        "//graph/clients/neo4j",
        "//graph/clients/neo4j/impl",
        "//graph/clients/qdrant",
        "//graph/clients/qdrant/impl",
        "//graph/embed",
        "//graph/embed/lexical",
    ],
)

go_test(
    name = "di_test",
    srcs = ["context_test.go"],
    embed = [":di"],
    deps = [
        "//api_server/contract",
        "//graph/clients/neo4j/impl",
        "//graph/clients/qdrant/impl",
        "//graph/embed/lexical",
    ],
)
