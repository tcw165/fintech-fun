# Gap A HTTP proof entrypoint. Wires impl (DI).
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "cmd_lib",
    srcs = ["main.go"],
    importpath = "github.com/tcw165/fintech-fun/infra/activation/cmd",
    visibility = ["//visibility:private"],
    deps = [
        "//infra/activation/contract",
        "//infra/activation/impl",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "activation",
    embed = [":cmd_lib"],
    visibility = ["//visibility:public"],
)

# just smoke/gold run //infra/activation/cmd (package default target).
go_binary(
    name = "cmd",
    embed = [":cmd_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "cmd_test",
    srcs = ["main_test.go"],
    embed = [":cmd_lib"],
    deps = [
        "//infra/activation/contract",
    ],
)
