# Ingest orchestration. Child of models; uses graph contracts + sibling parser/classify.
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ingest",
    srcs = ["ingest.go"],
    importpath = "github.com/tcw165/fintech-fun/agents/skills/ingest/robinhood/corporate_actions/ingest",
    visibility = ["//visibility:public"],
    deps = [
        "//graph:graph",
        "//graph/clients/neo4j:neo4j",
        "//graph/clients/qdrant:qdrant",
        "//graph/embed:embed",
        "//agents/skills/ingest/robinhood/corporate_actions:corporate_actions",
        "//agents/skills/ingest/robinhood/corporate_actions/classify:classify",
        "//agents/skills/ingest/robinhood/corporate_actions/parser:parser",
    ],
)

go_test(
    name = "ingest_test",
    srcs = ["ingest_test.go"],
    embed = [":ingest"],
    deps = [
        "//graph:graph",
        "//graph/clients/neo4j/impl:impl",
        "//graph/clients/qdrant/impl:impl",
        "//graph/embed/lexical:lexical",
        "//agents/skills/ingest/robinhood/corporate_actions:corporate_actions",
        "//agents/skills/ingest/robinhood/corporate_actions/testdata:testdata",
    ],
)
