# Ingest orchestration. Child of models; uses graph contracts + sibling parser/classify.
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ingest",
    srcs = ["ingest.go"],
    importpath = "github.com/tcw165/fintech-fun/agents/skills/ingest/robinhood/corporate_actions/ingest",
    visibility = ["//visibility:public"],
    deps = [
        "//agents/skills/ingest/robinhood/corporate_actions",
        "//agents/skills/ingest/robinhood/corporate_actions/classify",
        "//agents/skills/ingest/robinhood/corporate_actions/parser",
        "//graph",
        "//graph/clients/neo4j",
        "//graph/clients/qdrant",
        "//graph/embed",
    ],
)

go_test(
    name = "ingest_test",
    srcs = ["ingest_test.go"],
    embed = [":ingest"],
    deps = [
        "//agents/skills/ingest/robinhood/corporate_actions",
        "//agents/skills/ingest/robinhood/corporate_actions/testdata",
        "//graph",
        "//graph/clients/neo4j/impl",
        "//graph/clients/qdrant/impl",
        "//graph/embed/lexical",
    ],
)
