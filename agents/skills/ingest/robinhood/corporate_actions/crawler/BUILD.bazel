# CLI. Child of models; depends on parser, classify, ingest. Parent does not import this.
load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "crawler_lib",
    srcs = ["main.go"],
    importpath = "github.com/tcw165/fintech-fun/agents/skills/ingest/robinhood/corporate_actions/crawler",
    visibility = ["//visibility:private"],
    deps = [
        "//agents/skills/ingest/robinhood/corporate_actions:corporate_actions",
        "//agents/skills/ingest/robinhood/corporate_actions/classify:classify",
        "//agents/skills/ingest/robinhood/corporate_actions/ingest:ingest",
        "//agents/skills/ingest/robinhood/corporate_actions/parser:parser",
    ],
)

go_binary(
    name = "crawler",
    embed = [":crawler_lib"],
    visibility = ["//visibility:public"],
)
